APP_NAME="Campus Digital - Recompensas"
APP_ENV=local
# Se genera automáticamente en el contenedor (php artisan key:generate)
APP_KEY=
# true SOLO en desarrollo: en producción debe ser false para no exponer trazas
APP_DEBUG=true
APP_URL=http://localhost:8000
# Origen del frontend (CORS). Varios orígenes separados por coma.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MongoDB 7 en replica set rs0 (requerido para transacciones).
# En Docker, MONGO_DB_DSN lo inyecta docker-compose.yml con las credenciales del .env raíz.
# Desde el host (fuera de Docker) usar: mongodb://USER:PASS@127.0.0.1:27017/?authSource=admin&directConnection=true
DB_CONNECTION=mongodb
MONGO_DB_DSN="mongodb://root:change-me-local-only@mongodb:27017/?authSource=admin&replicaSet=rs0"
MONGO_DB_DATABASE=campus_digital

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Autenticación API (Laravel Sanctum, tokens Bearer). Minutos de vida del token.
SANCTUM_TOKEN_EXPIRATION=480
# Intentos de login permitidos por minuto (por email + IP)
LOGIN_RATE_LIMIT=5

# Contraseña de los usuarios DEMO creados por el seeder (solo APP_ENV=local/testing).
# Si se deja vacía, el seeder genera una aleatoria y la imprime una sola vez.
DEMO_USER_PASSWORD=

# Integración con otros equipos (ventas/inventario). Ver docs/INTEGRACIONES.md
# Si INVENTORY_DRIVER=none, los canjes de recompensas con inventario externo quedan en stock_pending.
INVENTORY_DRIVER=none

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@campus.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
