APP_NAME="Campus Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mongodb
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=campus_digital

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Demo admin. Change these values before any non-academic deployment.
CAMPUS_ADMIN_EMAIL=admin@campus.local
CAMPUS_ADMIN_PASSWORD=admin12345
CAMPUS_ADMIN_NAME="Administrador Campus"
