APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

QUEUE_FAILED_DRIVER=null

MONGODB_URI=mongodb://mongodb:27017
# Publicador de eventos intermodulares: acordar destino y autenticacion con Equipo 7.
# Sin URL, el comando falla sin enviar eventos. Usar HTTPS hacia un destino controlado en produccion.
# EVENTS_SINK_URL=
# EVENTS_SINK_TOKEN=
EVENTS_SINK_TIMEOUT=10
EVENTS_PUBLISH_BATCH=100
# El lease debe superar EVENTS_SINK_TIMEOUT.
EVENTS_CLAIM_LEASE_SECONDS=60

MONGODB_DATABASE=campus_digital

WWWUSER=1000
WWWGROUP=1000

# Integración Comunidad -> API de Identidad (credenciales solo en .env)
IDENTIDAD_API_URL=
IDENTIDAD_CLIENT_ID=
IDENTIDAD_CLIENT_SECRET=
COMUNIDAD_DIRECTORIO_ORGANIZACIONES_ENABLED=false

# Marketplace: fill with local client credentials; never commit secrets.
MARKETPLACE_DATABASE=
MARKETPLACE_IDENTIDAD_URL=http://app
MARKETPLACE_IDENTIDAD_CLIENT_ID=
MARKETPLACE_IDENTIDAD_CLIENT_SECRET=
MARKETPLACE_COMUNIDAD_URL=http://app
MARKETPLACE_COMUNIDAD_CLIENT_ID=
MARKETPLACE_COMUNIDAD_CLIENT_SECRET=
MARKETPLACE_INVENTARIO_URL=http://app

# E4 to E7: requires an agreed receiver; disabled by default.
INVENTARIO_E7_OUTBOX_HABILITADO=false
TEAM7_WEBHOOK_URL=
INVENTARIO_E7_SECRETO=
INVENTARIO_E7_INBOX_HABILITADO=false

# E6: requires identity:nfc:validate on its existing Identity client.
COMUNIDAD_EVENTOS_NFC_HABILITADO=false

# Integración E2: SQL Server exclusivo del alterno. Generar contraseñas locales.
SQLSERVER_SA_PASSWORD=
SQLSRV_HOST=sqlserver
SQLSRV_PORT=1433
SQLSRV_DATABASE=campus_digital_financial
SQLSRV_USERNAME=campus_integracion
SQLSRV_PASSWORD=
SQLSRV_ENCRYPT=yes
SQLSRV_TRUST_SERVER_CERTIFICATE=true
# E7 recibe auditorías por API firmada, deshabilitada hasta activar explícitamente.
PLATFORM_DATABASE=
PLATFORM_INGEST_ENABLED=false
PLATFORM_COMMUNITY_SECRET=
PLATFORM_DELIVERY_ENABLED=false
PLATFORM_API_URL=http://app

# Piloto BECA de Comunidad y Finanzas
COMMUNITY_BECA_FINANCE_ENABLED=false
COMMUNITY_BECA_API_URL=http://app
FINANCIAL_BECA_API_URL=http://app
FINANCIAL_COMMUNITY_BECA_CLIENT_ID=
FINANCIAL_COMMUNITY_BECA_CLIENT_SECRET=
COMMUNITY_FINANCIAL_BECA_CLIENT_ID=
COMMUNITY_FINANCIAL_BECA_CLIENT_SECRET=
FINANCIAL_COMMUNITY_BECA_BUDGETS_JSON='{}'
FINANCIAL_MARKETPLACE_INSTITUTIONAL_BECA_ENABLED=false

# Piloto de tienda y entrega de pagos a Inventarios
MARKETPLACE_WALLET_CHECKOUT_ENABLED=false
MARKETPLACE_WALLET_PILOT_BUYER_ID=
MARKETPLACE_WALLET_PILOT_BUSINESS_ID=
MARKETPLACE_FINANZAS_URL=http://app
MARKETPLACE_FINANZAS_CLIENT_ID=
MARKETPLACE_FINANZAS_CLIENT_SECRET=
FINANCIAL_MARKETPLACE_ENABLED=false
FINANCIAL_MARKETPLACE_CLIENTS_JSON='{}'
FINANCIAL_TEAM4_WEBHOOK_ENABLED=false
FINANCIAL_TEAM4_PILOT_CLIENT_ID=
FINANCIAL_TEAM4_WEBHOOK_URL=
FINANCIAL_TEAM4_WEBHOOK_SECRET=
INVENTARIO_PAGOS_HABILITADOS=false

# Piloto de garantías de renta
FINANCIAL_RENTAL_DEPOSIT_PILOT_ENABLED=false
FINANCIAL_RENTAL_DEPOSIT_PILOT_CLIENT_ID=
SERVICIOS_FINANZAS_GARANTIAS_PILOT_TTL_SECONDS=0
SERVICIOS_FINANZAS_GARANTIAS_CLIENT_ID=
SERVICIOS_FINANZAS_GARANTIAS_CLIENT_SECRET=

# Authorization scoped to explicitly enabled Community organizations and personal transfers.
FINANCIAL_COMMUNITY_CASH_ASSOCIATIONS=
FINANCIAL_PERSONAL_WALLET_TRANSFERS_ENABLED=false

# Pagos de eventos de Comunidad (lista explícita para nuevas preparaciones).
COMUNIDAD_EVENTOS_PAGOS_ENABLED=false
COMUNIDAD_EVENTOS_PAGOS_ORGANIZACIONES='[]'
COMUNIDAD_FINANZAS_URL=http://app
COMUNIDAD_FINANZAS_CLIENT_ID=
COMUNIDAD_FINANZAS_CLIENT_SECRET=
FINANCIAL_EVENT_PAYMENTS_ENABLED=false
FINANCIAL_EVENT_PAYMENTS_CLIENT_ID=
FINANCIAL_EVENT_RECIPIENTS_JSON='{}'

# E2 -> E6: avisos privados de hechos confirmados. SINCE es obligatorio y acota el histórico.
FINANCIAL_COMMUNITY_NOTICES_ENABLED=false
FINANCIAL_COMMUNITY_NOTICES_URL=http://app
FINANCIAL_COMMUNITY_NOTICES_CLIENT_ID=
FINANCIAL_COMMUNITY_NOTICES_CLIENT_SECRET=
FINANCIAL_COMMUNITY_NOTICES_SINCE=

# E6 -> E7: solo agregados publicados/cerrados; corte ISO obligatorio.
PLATFORM_COMMUNITY_ANALYTICS_ENABLED=false
PLATFORM_COMMUNITY_ANALYTICS_SINCE=
# E7 -> E6: avisos privados de puntos y canjes, mediante cliente dedicado.
PLATFORM_COMMUNITY_NOTICES_ENABLED=false
PLATFORM_COMMUNITY_NOTICES_URL=http://app
PLATFORM_COMMUNITY_NOTICES_CLIENT_ID=
PLATFORM_COMMUNITY_NOTICES_CLIENT_SECRET=
PLATFORM_COMMUNITY_NOTICES_SINCE=
