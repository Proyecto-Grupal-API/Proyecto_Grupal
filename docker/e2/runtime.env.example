# Copy manually to docker/e2/local/.env. This template has no real credentials.
# Preserve the existing installation APP_KEY if sharing its encrypted data.
APP_NAME="Campus Digital"
APP_KEY=
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8082
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mongodb
DB_HOST=host.docker.internal
DB_PORT=27017
DB_DATABASE=campus_virtual
# Adjust authentication if your MongoDB requires it; encode URI credentials.
# directConnection avoids discovering the Windows loopback address as a remote host.
MONGODB_DSN="mongodb://host.docker.internal:27017/?replicaSet=rs0&directConnection=true"

SQLSRV_HOST=host.docker.internal
SQLSRV_PORT=1433
SQLSRV_DATABASE=campus_digital_financial
SQLSRV_USERNAME=campus_financial
SQLSRV_PASSWORD=
SQLSRV_ENCRYPT=yes
# Local self-signed certificate only. Production requires a trusted certificate.
SQLSRV_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=file
SESSION_COOKIE=campus_e2_docker_session
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=stderr
OAUTH2_ISSUER=http://127.0.0.1:8082
OAUTH2_AUDIENCE=campus-virtual-services
# If your existing installation uses a separate OAuth signing key, configure it here.
# OAUTH2_SIGNING_KEY=

# Compose enforces these switches off in this first local profile.
FINANCIAL_TEAM4_WEBHOOK_ENABLED=false
FINANCIAL_IDENTITY_AUTHORIZATION_ENABLED=false
FINANCIAL_MARKETPLACE_ENABLED=false
FINANCIAL_MARKETPLACE_INSTITUTIONAL_BECA_ENABLED=false
FINANCIAL_HOLD_SCHEDULE_EXPIRATION=false
FINANCIAL_RECONCILIATION_SCHEDULE_ENABLED=false
FINANCIAL_INSTITUTIONAL_BECA_EXPIRATION_ENABLED=false
