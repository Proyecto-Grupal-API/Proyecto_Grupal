{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "campus-digital/equipo4",
  "type": "project",
  "description": "Campus Digital - Maquetado Equipo 4",
  "keywords": [
    "laravel",
    "inertia",
    "vue",
    "inventario"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "inertiajs/inertia-laravel": "^2.0",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^3.0",
    "mongodb/laravel-mongodb": "^5.8",
    "laravel/fortify": "^1.39"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --graceful --ansi",
      "npm install",
      "npm run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#fbbf24\" \"php artisan serve\" \"npm run dev\" --names=http,vite --kill-others"
    ],
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
