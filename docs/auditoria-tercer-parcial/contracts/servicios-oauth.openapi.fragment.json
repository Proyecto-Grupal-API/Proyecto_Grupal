    "/api/v1/comunidad/becas/{solicitud}/bono": {
      "get": {
        "summary": "Contrato financiero de una solicitud BECA aprobada",
        "operationId": "get_comunidad_beca_bono",
        "x-contract-status": "reviewed",
        "x-source": "app/Http/Controllers/Api/Community/BecaAwardController.php@__invoke",
        "description": "Requiere integración BECA habilitada, cliente E2 configurado y scope community:beca-award:read. Snapshot validado en BecaFinanceContract: solicitudes aprobadas, destino2, bono, contrato y clave coincidentes, estado pendiente_integracion/asignada. Exige fin de vigencia posterior al inicio; no emite dinero ni autoriza por sí mismo al humano. Aval puede ser null.",
        "security": [
          {
            "serviceBearer": []
          }
        ],
        "parameters": [
          {
            "name": "solicitud",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot del dictamen y aval persistido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "solicitud_id",
                        "beneficiario_id",
                        "organizacion_id",
                        "convocatoria_id",
                        "monto_centavos",
                        "moneda",
                        "vigencia_inicio",
                        "vigencia_fin_exclusiva",
                        "aval_tesoreria"
                      ],
                      "properties": {
                        "solicitud_id": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{24}$"
                        },
                        "beneficiario_id": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{24}$"
                        },
                        "organizacion_id": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{24}$"
                        },
                        "convocatoria_id": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{24}$"
                        },
                        "monto_centavos": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "moneda": {
                          "const": "MXN"
                        },
                        "vigencia_inicio": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "vigencia_fin_exclusiva": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "aval_tesoreria": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "presidencia_id": {
                                  "type": "string",
                                  "pattern": "^[a-f0-9]{24}$"
                                },
                                "tesoreria_id": {
                                  "type": "string",
                                  "pattern": "^[a-f0-9]{24}$"
                                },
                                "presupuesto_id": {
                                  "type": "string",
                                  "format": "uuid"
                                },
                                "monto_centavos": {
                                  "type": "integer",
                                  "minimum": 1
                                },
                                "huella_dictamen": {
                                  "type": "string",
                                  "pattern": "^[a-f0-9]{64}$"
                                },
                                "avalado_en": {
                                  "type": "string",
                                  "format": "date-time"
                                }
                              },
                              "additionalProperties": true,
                              "description": "Aval persistido E6. Puede ser null antes de Tesorería. Se declara proyección conocida sin afirmar que todos los documentos históricos tienen los campos."
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  }
