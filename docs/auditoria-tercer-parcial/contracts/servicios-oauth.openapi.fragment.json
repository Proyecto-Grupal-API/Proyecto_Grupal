          "notificacion_id": "66a123456789abcdef123458",
          "estado": "entregada",
          "motivo": null
        }
      },
      "AvisosError": {
        "type": "object",
        "required": [
          "codigo",
          "mensaje",
          "correlacion_id"
        ],
        "properties": {
          "codigo": {
            "type": "string"
          },
          "mensaje": {
            "type": "string"
          },
