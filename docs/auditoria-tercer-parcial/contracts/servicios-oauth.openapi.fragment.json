            "type": "string",
            "format": "uuid"
          },
          "errores": {
            "type": "object"
          }
        },
        "example": {
          "codigo": "clave_en_conflicto",
          "mensaje": "La clave ya se usó con un contenido diferente.",
          "correlacion_id": "43de1399-7a77-4872-8dbf-c13a9a717dbd"
        }
      },
      "AvisosAvisoServicios": {
        "type": "object",
        "required": [
          "destinatario_id",
          "tipo",
          "asunto",
          "texto",
          "accion"
        ],
        "properties": {
          "destinatario_id": {
            "type": "string",
            "maxLength": 128,
            "description": "User._id canónico de Identidad; se valida por su API de condición académica."
          },
          "tipo": {
            "type": "string",
            "enum": [
              "prestamo_por_vencer",
              "prestamo_vencido",
              "reserva_libro_disponible",
              "multa_generada",
              "locker_por_vencer",
              "lista_espera_promovida",
              "recordatorio_reserva",
              "no_show_registrado",
              "renta_por_devolver",
              "orden_lista",
              "ticket_actualizado"
            ]
          },
          "asunto": {
            "type": "string",
            "maxLength": 180,
            "description": "Texto sin HTML."
          },
          "texto": {
            "type": "string",
            "maxLength": 5000,
            "description": "Texto sin HTML."
          },
          "accion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "destino",
              "id"
            ],
            "properties": {
              "destino": {
                "type": "string",
                "enum": [
                  "mis_prestamos",
                  "mis_reservas_libros",
                  "mis_multas",
                  "mi_locker",
                  "mis_reservas",
                  "mis_rentas",
                  "mis_ordenes",
                  "mi_ticket"
                ]
              },
              "id": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9_-]+$"
              }
            }
          },
          "importancia": {
            "type": "string",
            "enum": [
              "normal",
              "alta"
            ],
            "default": "normal"
          },
          "expira_en": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "ISO 8601 con zona, posterior al primer envío. Un reintento posterior conserva el recibo."
          }
        },
        "example": {
          "destinatario_id": "66a123456789abcdef123456",
          "tipo": "orden_lista",
          "asunto": "Tu impresión está lista",
          "texto": "Recoge tu orden en Servicios al estudiante.",
          "accion": {
            "destino": "mis_ordenes",
            "id": "66a123456789abcdef123457"
          },
          "importancia": "normal"
        }
      },
      "AvisosAvisoFinanzas": {
        "type": "object",
        "required": [
          "destinatario_id",
          "tipo",
          "asunto",
          "texto",
          "accion"
        ],
        "properties": {
          "destinatario_id": {
            "type": "string",
            "maxLength": 128,
            "description": "User._id canónico de Identidad; se valida por su API de condición académica."
          },
          "tipo": {
            "type": "string",
            "enum": [
              "pago_evento_confirmado",
              "devolucion_confirmada",
              "beca_emitida"
            ]
          },
          "asunto": {
            "type": "string",
            "maxLength": 180,
            "description": "Texto sin HTML."
          },
          "texto": {
            "type": "string",
            "maxLength": 5000,
            "description": "Texto sin HTML."
          },
          "accion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "destino",
              "id"
            ],
            "properties": {
              "destino": {
                "type": "string",
                "enum": [
                  "comprobante_financiero",
                  "bono_financiero"
                ]
              },
              "id": {
